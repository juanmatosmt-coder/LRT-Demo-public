  "machine_shop_request": {
   "title": "Machine Shop Work Request",
   "short": "Machine shop",
   "target": "the machine shop queue (imaginary, for the demo)",
   "note": "One request per job: the requester, cost center and job are entered once, then up to 25 part numbers, each with its own drawing, CAD model and photos.",
   "upload_rule": {
    "accept": [
     ".pdf",
     ".step",
     ".stp",
     ".jpg",
     ".jpeg",
     ".png"
    ],
    "max_mb": 25.0,
    "where": "per item"
   },
   "steps": [
    {
     "n": 1,
     "title": "Requestor Information",
     "fields": [
      {
       "key": "requestType",
       "label": "Request Type",
       "type": "select",
       "required": true,
       "options": [
        "Tooling",
        "Fixture",
        "Gauge",
        "Prototype part",
        "Repair or modify",
        "Other"
       ]
      },
      {
       "key": "programName",
       "label": "Program Name",
       "type": "text",
       "required": false
      },
      {
       "key": "programNumber",
       "label": "Program #",
       "type": "text",
       "required": false
      },
      {
       "key": "requestorName",
       "label": "Requestor Name",
       "type": "text",
       "required": true,
       "source": "engineer profile"
      },
      {
       "key": "businessUnit",
       "label": "Business Unit",
       "type": "combo",
       "options": "businessUnit",
       "required": true,
       "note": "If the value is not listed, type it in."
      },
      {
       "key": "costCenter",
       "label": "Cost Center #",
       "type": "combo",
       "options": "bPCNumber",
       "required": true,
       "note": "If the value is not listed, type it in."
      },
      {
       "key": "phone",
       "label": "Phone",
       "type": "number",
       "required": false,
       "source": "engineer profile"
      },
      {
       "key": "email",
       "label": "Email",
       "type": "email",
       "required": true,
       "source": "engineer profile"
      },
      {
       "key": "emailCc",
       "label": "Email CC",
       "type": "text",
       "required": false,
       "note": "Other people to copy on updates, comma separated."
      }
     ]
    },
    {
     "n": 2,
     "title": "Job Scope",
     "fields": [
      {
       "key": "projectJobName",
       "label": "Project / Job Name",
       "type": "text",
       "required": true
      },
      {
       "key": "scopeOfWork",
       "label": "Scope of Work",
       "type": "textarea",
       "required": true
      },
      {
       "key": "partDeliveryMethod",
       "label": "Part Delivery Method",
       "type": "select",
       "required": true,
       "options": [
        "Pick up at the shop",
        "Deliver to the lab",
        "Ship to another site"
       ]
      },
      {
       "key": "requestedDueDate",
       "label": "Requested Due Date",
       "type": "date",
       "required": true
      },
      {
       "key": "priority",
       "label": "Priority",
       "type": "select",
       "required": true,
       "options": [
        "Low",
        "Normal",
        "High",
        "Line down"
       ]
      }
     ]
    },
    {
     "n": 3,
     "title": "Parts",
     "table": {
      "min_rows": 1,
      "max_rows": 25,
      "columns": [
       {
        "key": "partNumber",
        "label": "Part Number",
        "type": "text",
        "required": true,
        "lookup": {
         "format": "pn",
         "fill": {
          "rev": "rev",
          "description": "description",
          "material": "material"
         }
        }
       },
       {
        "key": "rev",
        "label": "Rev",
        "type": "text",
        "required": true
       },
       {
        "key": "description",
        "label": "Description",
        "type": "text",
        "required": true
       },
       {
        "key": "qty",
        "label": "Qty",
        "type": "number",
        "required": true
       },
       {
        "key": "material",
        "label": "Material",
        "type": "text",
        "required": true
       },
       {
        "key": "itemNotes",
        "label": "Notes for this part",
        "type": "textarea",
        "required": false
       }
      ],
      "item_files": {
       "kinds": [
        "drawing",
        "cad",
        "photos"
       ],
       "required": [
        "drawing",
        "cad"
       ],
       "match": "The drawing and the STEP file must be the same part number and revision; the STEP file is used for production."
      }
     }
    },
    {
     "n": 4,
     "title": "Additional Information",
     "fields": [
      {
       "key": "additionalInformation",
       "label": "Additional Information",
       "type": "textarea",
       "required": false
      }
     ]
    }
   ]
  },
  "purchase_requisition": {
   "title": "Purchase Requisition",
   "short": "Purchase req",
   "target": "the purchasing requisition (imaginary, for the demo)",
   "note": "One requisition per supplier: the supplier, shipping and account are entered once, then every line item. Line totals and the estimated cost are calculated as you type.",
   "upload_rule": {
    "accept": [
     ".pdf",
     ".xlsx",
     ".docx",
     ".jpg",
     ".jpeg",
     ".png"
    ],
    "max_mb": 25.0,
    "where": "per item"
   },
   "steps": [
    {
     "n": 1,
     "title": "Supplier",
     "fields": [
      {
       "key": "supplierName",
       "label": "Supplier Name",
       "type": "text",
       "required": true
      },
      {
       "key": "supplierCode",
       "label": "Supplier Code",
       "type": "text",
       "required": false,
       "note": "Leave blank for a new supplier."
      },
      {
       "key": "rfqNumber",
       "label": "RFQ # / Quote #",
       "type": "text",
       "required": false
      },
      {
       "key": "delivery",
       "label": "Delivery",
       "type": "text",
       "required": false
      },
      {
       "key": "terms",
       "label": "Terms",
       "type": "text",
       "required": false
      },
      {
       "key": "fob",
       "label": "F.O.B.",
       "type": "select",
       "required": false,
       "options": [
        "Origin",
        "Destination"
       ]
      },
      {
       "key": "shipVia",
       "label": "Ship Via",
       "type": "text",
       "required": false
      },
      {
       "key": "salesTax",
       "label": "Sales Tax",
       "type": "select",
       "required": true,
       "options": [
        "Taxable",
        "Exempt"
       ]
      },
      {
       "key": "confirming",
       "label": "Confirming order",
       "type": "radio",
       "options": "yesNo",
       "required": false,
       "note": "Yes if the order was already placed by phone or online."
      }
     ]
    },
    {
     "n": 2,
     "title": "Ship To and Invoice To",
     "fields": [
      {
       "key": "shipTo",
       "label": "Ship To",
       "type": "textarea",
       "required": true
      },
      {
       "key": "invoiceTo",
       "label": "Invoice To",
       "type": "textarea",
       "required": true
      },
      {
       "key": "attention",
       "label": "Attention",
       "type": "text",
       "required": true,
       "source": "engineer profile"
      }
     ]
    },
    {
     "n": 3,
     "title": "Line Items",
     "table": {
      "min_rows": 1,
      "max_rows": 100,
      "columns": [
       {
        "key": "qty",
        "label": "Quantity",
        "type": "number",
        "required": true
       },
       {
        "key": "uom",
        "label": "U/M",
        "type": "select",
        "required": true,
        "options": [
         "each",
         "pack",
         "box",
         "set",
         "ft",
         "m",
         "lb",
         "kg"
        ]
       },
       {
        "key": "supplierPartNumber",
        "label": "Supplier Part Number",
        "type": "text",
        "required": true
       },
       {
        "key": "description",
        "label": "Description",
        "type": "text",
        "required": true
       },
       {
        "key": "unitPrice",
        "label": "Unit Price (USD)",
        "type": "money",
        "required": true
       }
      ],
      "totals": {
       "qty": "qty",
       "price": "unitPrice"
      },
      "item_files": {
       "kinds": [
        "quote",
        "photos"
       ],
       "required": []
      }
     }
    },
    {
     "n": 4,
     "title": "Charges, Account and Approval",
     "fields": [
      {
       "key": "tax",
       "label": "Tax (USD)",
       "type": "money",
       "required": false
      },
      {
