{
 "_about": "Structure of the request forms for the local test suite: two lab request forms (a general lab test request, 4 steps; SMT lab test request, 6 steps), captured 2026-11-23. Field keys are the forms' own input names. Organisation lists (BPC number, business unit, manufacturing site) are SYNTHETIC here; the real lists stay in data/private/. The assistant prefills a draft of these fields for engineer approval and never submits. The machine shop form is an imaginary shop for the CMU demo, modelled on a one-part-per-submission shop form but itemized. The purchase requisition follows the layout of a paper requisition form, with synthetic values only.",
 "shared_lists": {
  "bPCNumber": [
   "U0000 - Synthetic Cost Center A",
   "U0001 - Synthetic Cost Center B"
  ],
  "businessUnit": [
   "BU-A",
   "BU-B",
   "Other"
  ],
  "mFGSite": [
   "SITE-A",
   "SITE-B",
   "Other"
  ],
  "testSite": [
   "Lab A"
  ],
  "testSampleStatus": [
   "Prototype",
   "Pre-Production",
   "Production",
   "Competitor"
  ],
  "projectType": [
   "Qualification",
   "New Product Development",
   "Product Extension",
   "Innovation",
   "Lab Activities (Lab Use Only)",
   "Operational Support",
   "Cost Reduction"
  ],
  "yesNo": [
   "yes",
   "no"
  ]
 },
 "common_steps": {
  "requester": [
   {
    "key": "firstName",
    "label": "First Name",
    "type": "text",
    "required": true,
    "source": "engineer profile"
   },
   {
    "key": "lastName",
    "label": "Last Name",
    "type": "text",
    "required": true,
    "source": "engineer profile"
   },
   {
    "key": "email",
    "label": "Email",
    "type": "email",
    "required": true,
    "source": "engineer profile"
   },
   {
    "key": "phone",
    "label": "Phone",
    "type": "number",
    "required": true,
    "source": "engineer profile"
   },
   {
    "key": "bPCNumber",
    "label": "BPC Number",
    "type": "select",
    "options": "bPCNumber",
    "required": true
   },
   {
    "key": "businessUnit",
    "label": "Business Unit",
    "type": "select",
    "options": "businessUnit",
    "required": true
   },
   {
    "key": "mFGSite",
    "label": "MFG Site",
    "type": "select",
    "options": "mFGSite",
    "required": true
   }
  ],
  "tests_table": {
   "title": "Description of Requested Testing",
   "min_rows": 1,
   "max_rows": 10,
   "columns": [
    {
     "key": "testsToBePerformed",
     "label": "Tests to be Performed",
     "type": "text",
     "required": true
    },
    {
     "key": "applicableSpecifications",
     "label": "Applicable Specifications",
     "type": "textarea",
     "required": true
    },
    {
     "key": "specificationRevision",
     "label": "Specification Revision",
     "type": "text",
     "required": true
    }
   ]
  },
  "additional_information": [
   {
    "key": "confidentialTestsOrSamples",
    "label": "Confidential tests or samples",
    "type": "radio",
    "options": "yesNo",
    "required": true
   },
   {
    "key": "canTestingBeSubcontracted",
    "label": "Can testing be subcontracted",
    "type": "radio",
    "options": "yesNo",
    "required": true,
    "note": "input name is canTestingBeSubContracted on the SMT form"
   },
   {
    "key": "additionalInformation",
    "label": "Additional Information",
    "type": "textarea",
    "required": true
   },
   {
    "key": "sendCopiesTo",
    "label": "Send copies of test results reports to",
    "type": "text",
    "required": true,
    "note": "up to 5 emails, comma separated. You always get the report; your own email is filled in by default."
   },
   {
    "key": "attachments",
    "label": "Attachments",
    "type": "file",
    "required": false,
    "accept": [
     ".pdf",
     ".docx"
    ],
    "multiple": true,
    "max_mb": 2.0
   }
  ],
  "site_only": "Both forms end with a 'verify you're human' arithmetic check before Submit. The duplicate GUI leaves it out because it never submits."
 },
 "forms": {
  "lab_test_request": {
   "title": "Laboratory Testing Request",
   "steps": [
    {
     "n": 1,
     "title": "Basic Details",
     "fields": [
      "@requester",
      {
       "key": "requestedTestingCompletionDate",
       "label": "Requested Testing Completion Date",
       "type": "date",
       "required": false
      },
      {
       "key": "resultsFormat",
       "label": "Results Format",
       "type": "select",
       "required": true,
       "options": [
        "Data and Observations",
        "Formal Report (Customer)",
        "Formal Report (Internal)",
        "Presentation Summary"
       ]
      },
      {
       "key": "testSite",
       "label": "Test Site",
       "type": "select",
       "options": "testSite",
       "required": false
      },
      {
       "key": "testSampleStatus",
       "label": "Test Sample Status",
       "type": "select",
       "options": "testSampleStatus",
       "required": true
      },
      {
       "key": "projectType",
       "label": "Project Type",
       "type": "select",
       "options": "projectType",
       "required": true
      }
     ]
    },
    {
     "n": 2,
     "title": "Test Sample Information",
     "table": {
      "min_rows": 1,
      "max_rows": 10,
      "columns": [
       {
        "key": "productName",
        "label": "Product Name",
        "type": "text",
        "required": true
       },
       {
        "key": "partNumberRevision",
        "label": "Part Number Revision",
        "type": "text",
        "required": true,
        "lookup": {
         "format": "pn_rev",
         "fill": {
          "productName": "product_name",
          "housingMaterial": "housing_material",
          "contactBaseMaterial": "contact_base_material",
          "contactPlating": "contact_plating",
          "contactLubricant": "contact_lubricant"
         }
        }
       },
       {
        "key": "traceabilityMfgLotInfo",
        "label": "Traceability Mfg Lot Info",
        "type": "text",
        "required": true
       },
       {
        "key": "contactBaseMaterial",
        "label": "Contact Base Material",
        "type": "text",
        "required": false
       },
       {
        "key": "contactPlating",
        "label": "Contact Plating",
        "type": "text",
        "required": false
       },
       {
        "key": "contactLubricant",
        "label": "Contact Lubricant",
        "type": "text",
        "required": false
       },
       {
        "key": "housingMaterial",
        "label": "Housing Material",
        "type": "text",
        "required": true
       },
       {
        "key": "quantity",
        "label": "Quantity",
        "type": "number",
        "required": true
       }
      ],
      "item_files": {
       "kinds": [
        "drawing",
        "cad",
        "photos"
       ],
       "required": []
      }
     }
    },
    {
     "n": 3,
     "title": "Description of Requested Testing",
     "fields": [
      {
       "key": "postTestingSampleDisposition",
       "label": "Post-Testing Sample Disposition",
       "type": "select",
       "required": true,
       "options": [
        "Send back to requestor",
        "Scrap",
        "Keep in the lab"
       ]
      }
     ],
     "table": "@tests_table"
    },
    {
     "n": 4,
     "title": "Additional Information",
     "fields": [
      "@additional_information"
     ],
     "footer": "Unless otherwise specified, assessment of conformity to requirements is based on simple acceptance."
    }
   ],
   "short": "General lab",
   "target": "the lab's online request form",
   "upload_rule": {
    "accept": [
     ".pdf",
     ".docx"
    ],
    "max_mb": 2.0,
    "where": "one attachment box for the whole request"
   }
  },
